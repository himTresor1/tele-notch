---
// A small animated copy of the TeleNotch panel that acts out one shortcut on a loop:
// the keycaps press down, then the notch does what the app does. Click the keys to replay.
import Keys from "./Keys.astro";

export type Scene =
  | "toggle" | "play" | "speed" | "back" | "edit"
  | "listen" | "answer" | "catchup" | "help" | "settings";
interface Props { scene: Scene; combo: string }
const { scene, combo } = Astro.props;

const script = [
  "Thanks, everyone. Let's start with the numbers.",
  "Revenue grew 18% this quarter,",
  "mostly from the two new regions.",
  "Churn is down to 2.1%,",
  "the lowest it has been in two years.",
  "Next, the hiring plan for Q1.",
  "We're opening four roles in design",
  "and two in support.",
  "Questions so far? Happy to go deeper.",
];
const shortcuts = [
  ["⌃⌥Space", "Hide"], ["⌃⌥P", "Play"], ["⌃⌥↑↓", "Speed"], ["⌃⌥←", "Back"],
  ["⌃⌥E", "Script"], ["⌃⌥L", "Listen"], ["⌃⌥↩", "Answer"], ["⌃⌥C", "Catch up"],
];
---
<figure class="demo" data-scene={scene} data-combo={combo}>
  <div class="stage">
    <div class="menubar"><span></span><span></span><span></span><i></i><i></i></div>
    <div class="np">
      <div class="glow"></div>
      <div class="bar">
        <div class="side l">
          <span class="listen"><i></i><b>Listen</b></span>
          <span class="pp" aria-hidden="true"><svg viewBox="0 0 10 10"><path class="play" d="M2 1.2v7.6L8.6 5z"/><g class="pause"><rect x="1.8" y="1.3" width="2.2" height="7.4" rx=".6"/><rect x="6" y="1.3" width="2.2" height="7.4" rx=".6"/></g></svg></span>
          <span class="wpm"><b>140</b> wpm</span>
        </div>
        <div class="cam"></div>
        <div class="side r">
          <span class="ans">Answer</span>
          <span class="say">Say this</span>
          <span class="dots">⋯</span>
        </div>
      </div>
      <div class="content">
        <div class="vp"><div class="lines">{script.map((l) => <p>{l}</p>)}</div></div>
        <div class="answer"><p></p></div>
        <div class="catch">
          <p><b>Topic</b> Office days: four, or two anchor days?</p>
          <p><b>Where it's going</b> Most people lean towards two.</p>
          <p><b>Asked you</b> “What do you think?”</p>
        </div>
        <div class="help">{shortcuts.map(([k, t]) => <span><kbd>{k}</kbd>{t}</span>)}</div>
      </div>
      <div class="hints"></div>
    </div>

    <div class="win editor">
      <div class="tb"><i></i><i></i><i></i><span>Script</span></div>
      <div class="txt"><span class="typed"></span><span class="caret"></span></div>
      <div class="foot"><span class="count">0 words · saved automatically</span><span class="btn">Start Scrolling</span></div>
    </div>
    <div class="win settings">
      <div class="tb"><i></i><i></i><i></i><span>Settings</span></div>
      <div class="rows">
        <div><span>Model</span><b>Claude Haiku ▾</b></div>
        <div><span>Mode</span><b>Meeting ▾</b></div>
        <div><span>Text size</span><em><s style="width:40%"></s></em></div>
        <div><span>Teal glow</span><u class="on"></u></div>
      </div>
    </div>
    <div class="ticker"></div>
  </div>
  <figcaption>
    <button class="press" type="button" aria-label="Replay this demo"><Keys combo={combo} size="lg" /></button>
    <span class="status" aria-live="polite"></span>
  </figcaption>
</figure>

<style>
  .demo { margin: 10px 0 8px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; }
  .stage {
    position: relative; height: 250px; overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% -10%, rgba(20,184,166,.10), transparent 60%),
      linear-gradient(180deg, #f6f7f9, #eceef1);
  }
  .menubar { position: absolute; inset: 0 0 auto; height: 22px; display: flex; align-items: center; gap: 12px; padding: 0 14px; }
  .menubar span { width: 26px; height: 5px; border-radius: 3px; background: rgba(0,0,0,.12); }
  .menubar span:first-child { width: 12px; }
  .menubar i { width: 14px; height: 5px; border-radius: 3px; background: rgba(0,0,0,.12); }
  .menubar i:first-of-type { margin-left: auto; }

  /* The panel: black, hangs from the top edge, grows out of the notch */
  .np {
    position: absolute; left: 50%; top: 0; width: min(470px, calc(100% - 28px));
    transform: translateX(-50%); height: 168px; color: #fff;
    background: #000; border-radius: 0 0 22px 22px; overflow: hidden;
    box-shadow: 0 18px 40px rgba(0,0,0,.22);
    transition: height .45s cubic-bezier(.3,.7,.2,1), width .45s cubic-bezier(.3,.7,.2,1), border-radius .45s;
  }
  .np.collapsed { height: 26px; width: 150px; border-radius: 0 0 12px 12px; }
  .np.collapsed > :not(.bar), .np.collapsed .side { opacity: 0; }
  .glow {
    position: absolute; left: 50%; top: 58%; width: 70%; height: 90%; transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(20,184,166,.55), rgba(20,184,166,.12) 60%, transparent);
    filter: blur(18px); pointer-events: none; transition: opacity .3s;
    animation: drift 7s ease-in-out infinite alternate, breathe 4.5s ease-in-out infinite alternate;
  }
  .np.streaming .glow { opacity: 1; filter: blur(14px) brightness(1.35); }
  @keyframes drift { from { margin-left: -7%; } to { margin-left: 7%; } }
  @keyframes breathe { from { opacity: .8; scale: .94; } to { opacity: 1; scale: 1.08; } }

  .bar { position: relative; z-index: 1; height: 26px; display: flex; align-items: center; justify-content: space-between; padding: 0 12px; font-size: 10.5px; }
  .side { display: flex; align-items: center; gap: 7px; transition: opacity .25s; }
  .cam { width: 128px; height: 100%; }
  .listen { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 99px; background: rgba(255,255,255,.1); font-weight: 600; transition: background .25s; }
  .listen i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.45); transition: background .25s; }
  .listening .listen { background: rgba(239,68,68,.22); }
  .listening .listen i { background: #ef4444; animation: pulse 1.2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  .pp { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: rgba(255,255,255,.12); }
  .pp svg { width: 8px; height: 8px; fill: #fff; }
  .pp .pause, .playing .pp .play { display: none; }
  .playing .pp .pause { display: inline; }
  .wpm { color: rgba(255,255,255,.65); font-variant-numeric: tabular-nums; }
  .wpm b { color: #fff; font-weight: 600; display: inline-block; transition: transform .2s, color .2s; }
  .wpm b.bump { transform: scale(1.35); color: #5eead4; }
  .ans, .say { padding: 2px 9px; border-radius: 99px; font-weight: 600; }
  .ans { background: rgba(255,255,255,.12); }
  .say { display: none; background: rgba(20,184,166,.28); color: #99f6e4; }
  .answering .ans { display: none; }
  .answering .say { display: inline; }
  .dots { color: rgba(255,255,255,.6); }

  .content { position: absolute; z-index: 1; inset: 30px 18px 26px; }
  .content > * { position: absolute; inset: 0; transition: opacity .3s ease, transform .3s ease; }
  .vp { overflow: hidden; mask-image: linear-gradient(transparent, #000 18%, #000 78%, transparent); }
  .lines { will-change: transform; padding-top: 34px; }
  .lines p { margin: 0; text-align: center; font-size: 17px; line-height: 27px; font-weight: 600; color: #fff; }
  .answer, .catch, .help { opacity: 0; transform: translateY(6px); pointer-events: none; }
  .answer { display: flex; align-items: center; justify-content: center; }
  .answer p { margin: 0; text-align: center; font-size: 16.5px; line-height: 1.42; font-weight: 600; color: #fff; }
  .catch { display: flex; flex-direction: column; justify-content: center; gap: 5px; }
  .catch p { margin: 0; font-size: 13px; line-height: 1.35; color: rgba(255,255,255,.88); opacity: 0; transform: translateY(4px); transition: opacity .3s, transform .3s; }
  .catch p b { color: #5eead4; font-weight: 600; margin-right: 6px; }
  .catch.show p { opacity: 1; transform: none; }
  .catch.show p:nth-child(2) { transition-delay: .25s; }
  .catch.show p:nth-child(3) { transition-delay: .5s; }
  .help { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px 10px; align-content: center; font-size: 10.5px; color: rgba(255,255,255,.75); }
  .help span { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .help kbd { border: 0; font: 600 11px -apple-system, system-ui; padding: 3px 6px; border-radius: 5px; background: rgba(255,255,255,.14); color: #fff; }
  .mode-answer .vp, .mode-catch .vp, .mode-help .vp { opacity: 0; transform: translateY(-6px); }
  .mode-answer .answer, .mode-catch .catch, .mode-help .help { opacity: 1; transform: none; }

  .hints { position: absolute; z-index: 1; left: 0; right: 0; bottom: 7px; display: flex; justify-content: center; gap: 12px; font-size: 9.5px; color: rgba(255,255,255,.55); }
  .hints :global(kbd) { border: 0; font: 600 9px -apple-system, system-ui; padding: 1px 4px; border-radius: 4px; background: rgba(255,255,255,.13); color: #fff; margin-right: 3px; }

  /* Windows that open below the notch */
  .win {
    position: absolute; z-index: 2; left: 50%; top: 52px; width: min(330px, calc(100% - 40px));
    transform: translate(-50%, 14px) scale(.97); opacity: 0; pointer-events: none;
    background: #fff; border-radius: 11px; box-shadow: 0 22px 50px rgba(0,0,0,.2), 0 0 0 1px rgba(0,0,0,.06);
    transition: opacity .28s ease, transform .28s ease; font-size: 12px; color: var(--text);
  }
  .win.open { opacity: 1; transform: translate(-50%, 0) scale(1); }
  .tb { display: flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-bottom: 1px solid #eee; }
  .tb i { width: 9px; height: 9px; border-radius: 50%; background: #ff5f57; }
  .tb i:nth-child(2) { background: #febc2e; } .tb i:nth-child(3) { background: #28c840; }
  .tb span { margin-left: auto; margin-right: auto; font-weight: 600; font-size: 11.5px; transform: translateX(-16px); }
  .editor .txt { height: 92px; padding: 10px 12px; line-height: 1.5; color: #222; overflow: hidden; }
  .caret { display: inline-block; width: 1.5px; height: 14px; background: var(--teal); vertical-align: -2px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .editor .foot { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border-top: 1px solid #eee; color: var(--muted); font-size: 10.5px; }
  .editor .btn { background: var(--text); color: #fff; padding: 4px 10px; border-radius: 99px; font-weight: 600; transition: transform .1s, background .1s; }
  .editor .btn.hit { transform: scale(.94); background: var(--teal); }
  .settings .rows { padding: 6px 12px 10px; }
  .settings .rows div { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px solid #f1f1f3; }
  .settings .rows div:last-child { border: 0; }
  .settings .rows span { color: var(--muted); }
  .settings em { width: 110px; height: 4px; border-radius: 2px; background: #e5e5ea; position: relative; }
  .settings em s { position: absolute; inset: 0 auto 0 0; background: var(--teal-bright); border-radius: 2px; }
  .settings u { width: 26px; height: 15px; border-radius: 99px; background: var(--teal-bright); position: relative; }
  .settings u::after { content: ""; position: absolute; right: 2px; top: 2px; width: 11px; height: 11px; border-radius: 50%; background: #fff; }

  /* Live transcript lines under the notch */
  .ticker { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); width: min(430px, calc(100% - 40px)); display: flex; flex-direction: column; gap: 5px; }
  .ticker :global(p) {
    margin: 0; font-size: 12px; line-height: 1.35; padding: 6px 10px; border-radius: 9px;
    background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 0 0 1px rgba(0,0,0,.04); color: var(--body);
    animation: rise .3s ease both;
  }
  .ticker :global(p b) { font-weight: 700; margin-right: 6px; color: var(--text); }
  .ticker :global(p.me b) { color: var(--teal); }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }

  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-top: 1px solid var(--line); flex-wrap: wrap; }
  .press { all: unset; cursor: pointer; border-radius: 12px; }
  .press:focus-visible { outline: 2px solid var(--teal-bright); outline-offset: 4px; }
  .status { font-size: 13.5px; color: var(--muted); }

  @media (max-width: 560px) {
    .stage { height: 290px; }
    .cam { width: 70px; }
    .wpm, .dots { display: none; }
    .lines p { font-size: 15px; line-height: 24px; }
    .answer p { font-size: 14.5px; }
    .help { grid-template-columns: repeat(4, 1fr); font-size: 9px; }
    .np.collapsed { width: 110px; }
  }
  @media (prefers-reduced-motion: reduce) { .glow { animation: none; } }
</style>

<script>
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  class Demo {
    el: HTMLElement; np: HTMLElement; lines: HTMLElement; hints: HTMLElement; status: HTMLElement;
    ticker: HTMLElement; caps: HTMLElement[][]; scene: string;
    offset = 0; speed = 0; wpm = 140; raf = 0; last = 0; run = 0; visible = false;

    constructor(el: HTMLElement) {
      this.el = el;
      this.scene = el.dataset.scene!;
      this.np = el.querySelector(".np")!;
      this.lines = el.querySelector(".lines")!;
      this.hints = el.querySelector(".hints")!;
      this.status = el.querySelector(".status")!;
      this.ticker = el.querySelector(".ticker")!;
      // Keycaps grouped per shortcut (some demos show two: ⌃⌥↑ or ⌃⌥↓)
      this.caps = Array.from(el.querySelectorAll<HTMLElement>(".combo")).map((c) => Array.from(c.querySelectorAll<HTMLElement>(".cap")));
      el.querySelector(".press")!.addEventListener("click", () => this.start());
      new IntersectionObserver(([e]) => {
        this.visible = e.isIntersecting;
        if (this.visible && !this.run) this.start();
        if (!this.visible) this.stop();
      }, { threshold: 0.35 }).observe(el);
    }

    // ---- shared pieces ----
    reset() {
      this.np.className = "np";
      this.offset = 0; this.speed = 0; this.wpm = 140; this.setWpm(140, false);
      this.lines.style.transform = "translateY(0)";
      this.el.querySelectorAll(".win").forEach((w) => w.classList.remove("open"));
      this.el.querySelector(".catch")!.classList.remove("show");
      (this.el.querySelector(".answer p") as HTMLElement).textContent = "";
      (this.el.querySelector(".typed") as HTMLElement).textContent = "";
      this.ticker.innerHTML = "";
      this.say("");
      this.hint([["⌃⌥P", "Play"], ["⌃⌥↩", "Answer"], ["⌃⌥Space", "Hide"]]);
    }
    hint(items: [string, string][]) {
      this.hints.innerHTML = items.map(([k, t]) => `<span><kbd>${k}</kbd>${t}</span>`).join("");
    }
    say(s: string) { this.status.textContent = s; }
    mode(m: string | null) {
      this.np.classList.remove("mode-answer", "mode-catch", "mode-help");
      if (m) this.np.classList.add("mode-" + m);
    }
    setWpm(n: number, bump = true) {
      this.wpm = n;
      const b = this.el.querySelector(".wpm b") as HTMLElement;
      b.textContent = String(n);
      if (bump) { b.classList.add("bump"); setTimeout(() => b.classList.remove("bump"), 220); }
      if (this.speed) this.speed = n / 6.5;
    }
    play(on: boolean) {
      this.np.classList.toggle("playing", on);
      this.speed = on ? this.wpm / 6.5 : 0;
      cancelAnimationFrame(this.raf);
      if (!on) return;
      this.last = performance.now();
      const tick = (t: number) => {
        const dt = (t - this.last) / 1000; this.last = t;
        const max = this.lines.scrollHeight - 60;
        this.offset = Math.min(max, this.offset + this.speed * dt);
        this.lines.style.transform = `translateY(${-this.offset}px)`;
        this.raf = requestAnimationFrame(tick);
      };
      this.raf = requestAnimationFrame(tick);
    }
    jump(px: number) {
      this.lines.style.transition = "transform .35s ease";
      this.offset = Math.max(0, this.offset + px);
      this.lines.style.transform = `translateY(${-this.offset}px)`;
      setTimeout(() => (this.lines.style.transition = ""), 360);
    }
    async press(i = 0, label = "") {
      const caps = this.caps[i] ?? this.caps[0];
      if (label) this.say(label);
      for (const c of caps) { c.classList.add("down"); await wait(90); }
      await wait(260);
      caps.forEach((c) => c.classList.remove("down"));
    }
    line(who: "Me" | "Others", text: string) {
      const p = document.createElement("p");
      if (who === "Me") p.className = "me";
      p.innerHTML = `<b>${who}</b>${text}`;
      this.ticker.append(p);
      while (this.ticker.children.length > 2) this.ticker.firstElementChild!.remove();
    }
    async stream(text: string, alive: () => boolean) {
      const p = this.el.querySelector(".answer p") as HTMLElement;
      p.textContent = "";
      this.np.classList.add("streaming");
      for (const w of text.split(" ")) {
        if (!alive()) return;
        p.textContent += (p.textContent ? " " : "") + w;
        await wait(70);
      }
      this.np.classList.remove("streaming");
    }
    async type(text: string, alive: () => boolean) {
      const t = this.el.querySelector(".typed") as HTMLElement;
      const count = this.el.querySelector(".count") as HTMLElement;
      for (const ch of text) {
        if (!alive()) return;
        t.textContent += ch;
        count.textContent = `${t.textContent!.trim().split(/\s+/).length} words · saved automatically`;
        await wait(28);
      }
    }

    // ---- the scenes ----
    async scene_(alive: () => boolean) {
      const s = this.scene;
      const A = alive;
      if (s === "toggle") {
        this.say("The panel is showing.");
        await wait(1200); if (!A()) return;
        await this.press(0, "⌃⌥Space hides it…"); this.np.classList.add("collapsed");
        await wait(1700); if (!A()) return;
        await this.press(0, "…and shows it again."); this.np.classList.remove("collapsed");
        await wait(1800);
      } else if (s === "play") {
        this.say("Paused at the top of your script.");
        await wait(1100); if (!A()) return;
        await this.press(0, "Playing: the script scrolls."); this.play(true);
        this.hint([["⌃⌥P", "Pause"], ["⌃⌥↑↓", "Speed"], ["⌃⌥←", "Back"]]);
        await wait(3200); if (!A()) return;
        await this.press(0, "Paused."); this.play(false);
        this.hint([["⌃⌥P", "Play"], ["⌃⌥↩", "Answer"], ["⌃⌥Space", "Hide"]]);
        await wait(1600);
      } else if (s === "speed") {
        this.play(true); this.say("Scrolling at 140 words per minute.");
        this.hint([["⌃⌥P", "Pause"], ["⌃⌥↑↓", "Speed"], ["⌃⌥←", "Back"]]);
        await wait(1300); if (!A()) return;
        await this.press(0, "Faster: 150 wpm."); this.setWpm(150);
        await wait(700); if (!A()) return;
        await this.press(0, "Faster: 160 wpm."); this.setWpm(160);
        await wait(1500); if (!A()) return;
        await this.press(1, "Slower: 150 wpm."); this.setWpm(150);
        await wait(700); if (!A()) return;
        await this.press(1, "Back to 140 wpm."); this.setWpm(140);
        await wait(1300);
      } else if (s === "back") {
        this.offset = 110; this.lines.style.transform = "translateY(-110px)";
        this.play(true); this.say("You lost your place…");
        this.hint([["⌃⌥P", "Pause"], ["⌃⌥↑↓", "Speed"], ["⌃⌥←", "Back"]]);
        await wait(1700); if (!A()) return;
        await this.press(0, "…so jump back a few lines."); this.jump(-81);
        await wait(1500); if (!A()) return;
        await this.press(0, "Back again."); this.jump(-81);
        await wait(1800);
      } else if (s === "edit") {
        this.say("");
        await wait(900); if (!A()) return;
        await this.press(0, "The script editor opens.");
        this.el.querySelector(".editor")!.classList.add("open");
        await wait(400);
        await this.type("Thanks, everyone. Let's start with the numbers. Revenue grew 18% this quarter…", A);
        if (!A()) return;
        await wait(600);
        const b = this.el.querySelector(".editor .btn")!;
        b.classList.add("hit"); this.say("Start Scrolling, and you're live.");
        await wait(250); b.classList.remove("hit");
        this.el.querySelector(".editor")!.classList.remove("open");
        this.play(true);
        await wait(2400);
      } else if (s === "listen") {
        this.say("Not listening.");
        await wait(1100); if (!A()) return;
        await this.press(0, "Listening: both sides are transcribed on your Mac.");
        this.np.classList.add("listening");
        this.hint([["⌃⌥↩", "Answer"], ["⌃⌥C", "Catch up"], ["⌃⌥L", "Stop"]]);
        await wait(700); if (!A()) return;
        this.line("Others", "Let's look at the office plan for next year.");
        await wait(1500); if (!A()) return;
        this.line("Me", "Sure. I've got the numbers here.");
        await wait(1800); if (!A()) return;
        await this.press(0, "Stopped."); this.np.classList.remove("listening");
        this.hint([["⌃⌥P", "Play"], ["⌃⌥↩", "Answer"], ["⌃⌥Space", "Hide"]]);
        await wait(1400);
      } else if (s === "answer") {
        this.np.classList.add("listening");
        this.hint([["⌃⌥↩", "Answer"], ["⌃⌥C", "Catch up"], ["⌃⌥L", "Stop"]]);
        this.say("Someone asks you a question…");
        await wait(500); if (!A()) return;
        this.line("Others", "Four office days, or two anchor days? What do you think?");
        await wait(1500); if (!A()) return;
        await this.press(0, "Your answer, in your words. Read it out.");
        this.mode("answer"); this.np.classList.add("answering");
        this.hint([["⌃⌥↩", "Script"], ["⌃⌥P", "Close"]]);
        await this.stream("I'd go with two anchor days. Output went up last year with the hybrid setup, so let's keep what works.", A);
        if (!A()) return;
        await wait(2600); if (!A()) return;
        await this.press(0, "Back to your script."); this.mode(null); this.np.classList.remove("answering");
        this.hint([["⌃⌥↩", "Answer"], ["⌃⌥C", "Catch up"], ["⌃⌥L", "Stop"]]);
        await wait(1500);
      } else if (s === "catchup") {
        this.np.classList.add("listening");
        this.hint([["⌃⌥↩", "Answer"], ["⌃⌥C", "Catch up"], ["⌃⌥L", "Stop"]]);
        this.say("You drifted off for a minute…");
        await wait(1400); if (!A()) return;
        await this.press(0, "Three lines: the topic, where it's going, and if you were asked.");
        this.mode("catch"); this.np.classList.add("answering");
        await wait(60); this.el.querySelector(".catch")!.classList.add("show");
        await wait(3800); if (!A()) return;
        this.mode(null); this.np.classList.remove("answering"); this.el.querySelector(".catch")!.classList.remove("show");
        await wait(1200);
      } else if (s === "help") {
        this.say("Forgot a shortcut?");
        await wait(1100); if (!A()) return;
        await this.press(0, "Every shortcut, right in the notch.");
        this.mode("help"); this.hint([["⌃⌥/", "Done"]]);
        await wait(3200); if (!A()) return;
        await this.press(0, "Press again to close."); this.mode(null);
        this.hint([["⌃⌥P", "Play"], ["⌃⌥↩", "Answer"], ["⌃⌥Space", "Hide"]]);
        await wait(1400);
      } else if (s === "settings") {
        this.say("");
        await wait(1000); if (!A()) return;
        await this.press(0, "Settings: your API key, model, mode, text size and more.");
        this.el.querySelector(".settings")!.classList.add("open");
        await wait(3400); if (!A()) return;
        this.el.querySelector(".settings")!.classList.remove("open");
        await wait(1200);
      }
    }

    async start() {
      const id = ++this.run;
      const alive = () => this.run === id && this.visible;
      while (alive()) {
        this.reset();
        await this.scene_(alive);
        cancelAnimationFrame(this.raf);
      }
    }
    stop() { this.run = 0; cancelAnimationFrame(this.raf); }
  }

  document.querySelectorAll<HTMLElement>(".demo").forEach((el) => new Demo(el));
</script>
